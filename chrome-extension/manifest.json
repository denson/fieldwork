{
  "manifest_version": 3,
  "name": "Fieldwork Companion Pane",
  "version": "0.8.0",
  "description": "Connect Fieldwork lessons and BoodleBox chats, including user-approved business-plan drafts in both directions.",
  "minimum_chrome_version": "140",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://box.boodle.ai/*",
    "http://127.0.0.1:4173/*",
    "http://localhost:4173/*",
    "https://denson.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://box.boodle.ai/*"
      ],
      "js": [
        "routing.js",
        "business-draft.js",
        "draft.js",
        "transition-client.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:4173/*",
        "http://localhost:4173/*",
        "https://denson.github.io/colorado-weed-field-guide/*",
        "https://denson.github.io/fieldwork/*"
      ],
      "js": [
        "routing.js",
        "business-draft.js",
        "activity.js"
      ],
      "css": [
        "activity.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fieldwork Companion Pane",
    "default_popup": "popup.html"
  }
}
