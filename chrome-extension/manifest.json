{
  "manifest_version": 3,
  "name": "Fieldwork Companion Pane",
  "version": "0.10.11",
  "description": "Connect Fieldwork pages and BoodleBox chats in Chrome split view, with reviewed notes, support cases and planning drafts.",
  "minimum_chrome_version": "140",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://box.boodle.ai/*",
    "http://127.0.0.1:4173/*",
    "http://localhost:4173/*",
    "https://denson.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://box.boodle.ai/*"
      ],
      "js": [
        "routing.js",
        "business-draft.js",
        "support-packet.js",
        "draft.js",
        "connection.js",
        "connection-client.js",
        "transition-client.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:4173/*",
        "http://localhost:4173/*",
        "https://denson.github.io/colorado-weed-field-guide/*",
        "https://denson.github.io/fieldwork/*"
      ],
      "js": [
        "routing.js",
        "business-draft.js",
        "support-packet.js",
        "activity.js"
      ],
      "css": [
        "activity.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fieldwork Companion Pane",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "homepage_url": "https://denson.github.io/fieldwork/extension.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
